# Keep text files consistent across Windows, macOS and Linux.
* text=auto eol=lf

# Windows scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
